<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../nuget" />
    <add key="github" value="https://nuget.pkg.github.com/intochat/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <add key="github" value="true" />
  </disabledPackageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="DigitalBrain*" />
      <package pattern="IntoChat*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="DigitalBrain*" />
      <package pattern="IntoChat*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
