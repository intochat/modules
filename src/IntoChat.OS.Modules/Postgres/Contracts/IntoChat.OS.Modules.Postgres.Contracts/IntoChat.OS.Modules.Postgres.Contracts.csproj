<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Postgres module contracts: read-only queries, schema reads and connection status.</Description>
    <RootNamespace>IntoChat.OS.Modules.Postgres.Contracts</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Neuron interfaces and signals use the IntoChat.OS wire vocabulary; module runtime uses Framework. -->
    <PackageReference Include="IntoChat.OS" />
  </ItemGroup>
</Project>
