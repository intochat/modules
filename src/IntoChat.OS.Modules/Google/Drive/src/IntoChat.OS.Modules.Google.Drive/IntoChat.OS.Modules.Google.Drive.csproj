<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Google Drive module: one Drive as read-only storage, signed in through the google-auth module.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>IntoChat.OS.Modules.Google.Drive</RootNamespace>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Google.Drive.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Google.Drive.Tests.Integration" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="IntoChat.OS.Framework" />
    <PackageReference Include="IntoChat.OS.Modules.Identity" />
    
    <ProjectReference Include="../../../Auth/src/IntoChat.OS.Modules.Google.Auth/IntoChat.OS.Modules.Google.Auth.csproj" />
  </ItemGroup>
</Project>
