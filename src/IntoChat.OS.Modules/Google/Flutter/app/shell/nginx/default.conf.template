map $http_upgrade $connection_upgrade {
    default upgrade;
    # Omit Connection for ordinary requests: ACA can truncate chunked responses
    # when it receives close (https://github.com/microsoft/azure-container-apps/issues/734).
    '' '';
}

# Preserve the canonical scheme when the platform ingress terminates TLS.
map $http_x_forwarded_proto $public_scheme {
    default $scheme;
    https https;
    http http;
}

# Query strings may contain a one-time sign-in ticket. Never log $request/$args.
log_format shell_proxy '$remote_addr "$request_method $uri $server_protocol" $status $body_bytes_sent';

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    access_log /var/log/nginx/access.log shell_proxy;
    # Upstream error diagnostics can echo the full URI, including a sign-in ticket.
    error_log /dev/null;
    client_max_body_size 16m;

    location = / {
        try_files /index.html =404;
    }

    location = /config.json {
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri @kernel;
    }

    location @kernel {
        proxy_pass ${INTOCHATOS_KERNEL_UPSTREAM};
        proxy_http_version 1.1;
        # Managed ingress routes upstream requests by its backend hostname.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $public_scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_ssl_server_name on;
        proxy_read_timeout 3600s;
        proxy_buffering off;
        proxy_redirect off;
    }
}
