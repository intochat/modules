<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Flutter module contracts: inbox and UI kit neurons.</Description>
    <RootNamespace>IntoChat.OS.Modules.Flutter.Contracts</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Neuron interfaces and signals use the IntoChat.OS wire vocabulary; module runtime uses Framework. -->
    <PackageReference Include="IntoChat.OS" />
  </ItemGroup>
</Project>
