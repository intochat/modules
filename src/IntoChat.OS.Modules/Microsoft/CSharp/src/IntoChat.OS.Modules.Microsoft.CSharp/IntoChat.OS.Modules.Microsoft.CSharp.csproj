    <InternalsVisibleTo Include="IntoChat.OS.Modules.Microsoft.CSharp.Tests.Integration" />
    <PackageReference Include="Azure.Identity" />
    <!-- Seeded into script compilation with DigitalBrain (CSharpScriptCheck); the sandbox carries the same pair. -->
    <PackageReference Include="DigitalBrain.UI" />
    <PackageReference Include="DigitalBrain.Runtime.Orleans" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Microsoft.Orleans.Reminders" />
    <ProjectReference Include="../../Contracts/IntoChat.OS.Modules.Microsoft.CSharp.Contracts/IntoChat.OS.Modules.Microsoft.CSharp.Contracts.csproj" />
    <ProjectReference Include="../../../Azure/Contracts/IntoChat.OS.Modules.Microsoft.Azure.Contracts/IntoChat.OS.Modules.Microsoft.Azure.Contracts.csproj" />
    <ProjectReference Include="../../../../AI/Contracts/IntoChat.OS.Modules.AI.Contracts/IntoChat.OS.Modules.AI.Contracts.csproj" />

    <PackageReference Include="IntoChat.OS.Framework" />
    <PackageReference Include="IntoChat.OS.Client" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="IntoChat.OS.Modules.Identity" /></ItemGroup>
</Project>
