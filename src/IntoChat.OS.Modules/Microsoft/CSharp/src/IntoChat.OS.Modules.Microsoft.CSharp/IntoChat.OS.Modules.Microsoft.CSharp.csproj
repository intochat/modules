<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Single-file C# apps that operate neurons, compiled and run in the C# sandbox.</Description>
    <RootNamespace>IntoChat.OS.Modules.Microsoft.CSharp</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="IntoChat.OS.Modules.Apps.Contracts" />
