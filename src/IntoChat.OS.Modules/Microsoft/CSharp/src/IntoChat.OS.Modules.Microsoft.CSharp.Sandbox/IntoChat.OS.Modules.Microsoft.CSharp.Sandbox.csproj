<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>Sandbox host: one process holding each brain's session and its compiled behaviors.</Description>
    <RootNamespace>IntoChat.OS.Modules.Microsoft.CSharp.Sandbox</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Microsoft.CSharp.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Microsoft.CSharp.Tests.Integration" />
    <!-- The protocol, the session connection and the client behaviors connect through; shared, never reloaded per behavior. -->
    <PackageReference Include="IntoChat.OS.Client" />
    <!-- The core vocabulary the script compiler seeds (DigitalBrain arrives through IntoChat.OS). -->
    <PackageReference Include="DigitalBrain.UI" />
    <!-- What an [App] program is run against: its app's requests and the shell's view tree (contracts only). -->
    <PackageReference Include="IntoChat.OS.Modules.Apps.Contracts" />
    <ProjectReference Include="../../../../Google/Flutter/Contracts/IntoChat.OS.Modules.Flutter.Contracts/IntoChat.OS.Modules.Flutter.Contracts.csproj" />
    <PackageReference Include="IntoChat.OS.Modules.Identity.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Circles.Contracts" />
    <PackageReference Include="IntoChat.OS.Modules.Flame.Contracts" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>
</Project>
