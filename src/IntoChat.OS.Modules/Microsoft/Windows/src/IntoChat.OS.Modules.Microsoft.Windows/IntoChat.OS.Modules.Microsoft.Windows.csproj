<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>A Windows PC as a connection: its files and console, run only on that machine and inside allowed roots.</Description>
    <RootNamespace>IntoChat.OS.Modules.Microsoft.Windows</RootNamespace>
    <IntoChatOSContractsHost>true</IntoChatOSContractsHost>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Microsoft.Windows.Tests.Unit" />
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Microsoft.Windows.Tests.Integration" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DigitalBrain" />
    <PackageReference Include="DigitalBrain.Capabilities.Connections" />
    <PackageReference Include="DigitalBrain.Runtime.Orleans" />
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="DigitalBrain.Capabilities.Storage" />
    <PackageReference Include="DigitalBrain.Runtime.Http" />
    <PackageReference Include="DigitalBrain.Identity.Local" />
  </ItemGroup>
</Project>