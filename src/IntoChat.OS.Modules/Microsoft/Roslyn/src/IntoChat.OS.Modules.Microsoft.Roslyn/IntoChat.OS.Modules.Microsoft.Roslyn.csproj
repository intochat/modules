<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>Roslyn workspace neuron. MSBuild loads the solution; the grain keeps it.</Description>
    <RootNamespace>IntoChat.OS.Modules.Microsoft.Roslyn</RootNamespace>
    <NoWarn>$(NoWarn);ORLEANSEXP005</NoWarn>
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntoChat.OS.Modules.Microsoft.Roslyn.Tests.Unit" />
    <ProjectReference Include="../../Contracts/IntoChat.OS.Modules.Microsoft.Roslyn.Contracts/IntoChat.OS.Modules.Microsoft.Roslyn.Contracts.csproj" />
    <PackageReference Include="IntoChat.OS.Framework" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="IntoChat.OS.Modules.Identity" /></ItemGroup>
</Project>
